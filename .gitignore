# Keep this public repository opt-in. To add another configuration, reopen its
# parent directories and its selected files below; also update Stow's policy.
/*
!/.gitignore
!/.stow-local-ignore
!/.stowrc
!/README.md
!/.zshrc

# Selected XDG configurations. Every new application is ignored by default.
!/.config/
/.config/*
!/.config/btop/
!/.config/btop/**
!/.config/ghostty/
!/.config/ghostty/**
!/.config/kitty/
!/.config/kitty/**
!/.config/lazydocker/
!/.config/lazydocker/**
!/.config/lazygit/
!/.config/lazygit/**
!/.config/mise/
!/.config/mise/**
!/.config/nvim/
!/.config/nvim/**
!/.config/tmux/
!/.config/tmux/**
!/.config/wezterm/
!/.config/wezterm/**

# Raycast scripts only; its extensions, endpoints, and caches stay local.
!/.config/raycast/
/.config/raycast/*
!/.config/raycast/scripts/
!/.config/raycast/scripts/**

# Zed settings only; keymaps, tasks, conversations, and databases stay local.
!/.config/zed/
/.config/zed/*
!/.config/zed/settings.json

# Authored agent skills and their installer lock, without Skill Studio state.
!/.agents/
/.agents/*
!/.agents/.skill-lock.json
!/.agents/skills/
!/.agents/skills/**
/.agents/skills/.skill-studio-quarantine/

# Claude's portable settings only. Local settings, hooks, and skills stay local.
!/.claude/
/.claude/*
!/.claude/settings.json

# Emacs source is public; its nested .gitignore excludes private/runtime files.
!/.emacs.d/
!/.emacs.d/**

# Oh My Zsh themes only.
!/.oh-my-zsh/
/.oh-my-zsh/*
!/.oh-my-zsh/themes/
!/.oh-my-zsh/themes/**

# Cursor settings and keybindings only. Each ancestor must be reopened.
!/Library/
/Library/*
!/Library/Application Support/
/Library/Application Support/*
!/Library/Application Support/Cursor/
/Library/Application Support/Cursor/*
!/Library/Application Support/Cursor/User/
/Library/Application Support/Cursor/User/*
!/Library/Application Support/Cursor/User/settings.json
!/Library/Application Support/Cursor/User/keybindings.json

# Generated files inside otherwise allowed configurations.
**/.DS_Store
**/.git
**/*~
**/\#*\#
**/.#*
/.config/**/.tmp*
/.config/tmux/plugins/
/.config/**/*.log
/.config/lazygit/state.yml
